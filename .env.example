# Copy to .env and fill in. Everything here is optional -- the tool works
# unauthenticated, just slower and closer to the rate limit.

# Unauthenticated GitHub allows 60 requests/hour, which a full `fetch --all`
# can brush against. A token (no scopes needed, just a bare classic PAT or
# fine-grained token with public read) raises it to 5000/hour.
GITHUB_TOKEN=

# The setup wizard saves these for you. Set them here only to override it.
# BML_VAULT=C:\Games\Balatro Mod Library
# BML_GAME_MODS=C:\Users\you\AppData\Roaming\Balatro\Mods
# BML_GAME_DIR=C:\Program Files (x86)\Steam\steamapps\common\Balatro
